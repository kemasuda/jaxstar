# Local development work stays ignored; only these shared helpers are versioned.
/dev_notebooks/*
!/dev_notebooks/specfit/
/dev_notebooks/specfit/*
!/dev_notebooks/specfit/specmodel_diagnostic.py
!/dev_notebooks/specfit/_specmodel_reference.py
!/dev_notebooks/specfit/_specmodel_plotting.py
!/dev_notebooks/specfit/_spectral_inference_data.py
!/dev_notebooks/specfit/spectral_inference_real_setup.py
!/dev_notebooks/specfit/specfit_end_to_end.ipynb
/examples/tutorials/.specmodel-data/
/benchmark-results/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Local coordination notes; root AGENTS.md stays visible and untracked.
/docs/local/

# Local research data and backups
/stellar-analyses/
/.git_broken/
/tests/unittests/MIST_iso_*.iso.cmd

# Legacy local files already excluded from package builds
/src/jaxstar/jaxstar_version.py
/src/jaxstar/mistfit/mistgrid/__init__.py
